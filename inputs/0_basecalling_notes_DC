gunzip GCF_009914755.1_T2T-CHM13v2.0_human_reference.fna.gz

NAVIGATE to /<batch_address>/output_demux_<mode> first! (whether it is "hac" or "sup")
for i in /srv/nfs_share/2026_RESPIRO/raw_data/SCOVEX_SISPA_3_11082026/SCOVEX_SISPA_3_11082026/20260811_1608_X3_FBF96443_9c1bb3a1/output_demux_hac/*.fastq; do 
	out_dir="$(dirname "$i")/exclude_host_hac"
	mkdir -p "$out_dir"
	b=$(basename "$i" .fastq)
	ref="/srv/nfs_share/2026_RESPIRO/inputs/GCF_009914755.1_T2T-CHM13v2.0_genomic.fna"
	
	minimap2 -t 30 -ax map-ont "$ref" "$i" | \
	samtools view -@ 30 -b -f 4 | \
	samtools sort -@ 30 -o "${out_dir}/${b}_non_host_sorted.bam"
	samtools fastq -@ 30 "${out_dir}/${b}_non_host_sorted.bam" > "${out_dir}/${b}_non_host_sorted.fastq"
done
mv exclude_host_hac ..

mkdir /srv/nfs_share/2026_RESPIRO/raw_data/0_compiled_fastq
cp /srv/nfs_share/2026_RESPIRO/raw_data/SCOVEX_SISPA_3_11082026/SCOVEX_SISPA_3_11082026/20260811_1608_X3_FBF96443_9c1bb3a1/exclude_host_hac/*.fastq /srv/nfs_share/2026_RESPIRO/raw_data/0_compiled_fastq

mkdir /srv/nfs_share/2026_RESPIRO/raw_data/0_compiled_fastq_wf_metagenomics_target
